generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(cuid())
  name       String?
  email      String      @unique
  password   String
  role       Role        @default(CUSTOMER)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  expenses   Expense[]   @relation("PartnerExpenses")
  orders     Order[]
  loanSplits LoanSplit[]
  expensePayments ExpensePayment[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  quantity    Int
  category    String
  image       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id            String              @id @default(cuid())
  userId        String?
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  total         Float
  status        OrderStatus         @default(PLACED)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User?               @relation(fields: [userId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  oldStatus   OrderStatus?
  newStatus   OrderStatus
  changedAt   DateTime    @default(now())
  changedBy   String?     // Admin user ID
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Expense {
  id              String          @id @default(cuid())
  title           String
  amount          Float
  paymentSource   PaymentSource   @default(FARM_WALLET) // Who paid?
  paidByPartnerId String? // If PARTNER paid, which one?
  category        ExpenseCategory
  date            DateTime        @default(now())
  notes           String?
  createdAt       DateTime        @default(now())
  paidBy          User?           @relation("PartnerExpenses", fields: [paidByPartnerId], references: [id])
  payments        ExpensePayment[]
}

model ExpensePayment {
  id        String        @id @default(cuid())
  expenseId String
  amount    Float
  source    PaymentSource // FARM_WALLET or PARTNER
  partnerId String?       // Required if source == PARTNER
  expense   Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  partner   User?         @relation(fields: [partnerId], references: [id])
}

model Loan {
  id              String       @id @default(cuid())
  name            String
  principalAmount Float
  interestRate    Float // Annual rate in percentage
  tenureMonths    Int
  interestType    InterestType
  interestAmount  Float
  totalPayable    Float
  startDate       DateTime
  status          LoanStatus   @default(ACTIVE)
  splits          LoanSplit[]
}

model LoanSplit {
  id        String @id @default(cuid())
  loanId    String
  partnerId String
  amount    Float
  loan      Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  partner   User   @relation(fields: [partnerId], references: [id])
}

enum PaymentSource {
  FARM_WALLET
  PARTNER
  MIXED
}

enum LoanStatus {
  ACTIVE
  SETTLED
}

enum InterestType {
  SIMPLE
  COMPOUND
}

enum Role {
  ADMIN
  PARTNER
  CUSTOMER
}

enum OrderStatus {
  PLACED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ExpenseCategory {
  SEEDS
  FERTILIZER
  LABOUR
  TRANSPORT
  LOAN_PROCESSING
  LOAN_EMI
  OTHER
}
